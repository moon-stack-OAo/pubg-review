# PUBG Developer API Key（仅服务端，切勿提交真实 Key）
# 申请：https://developer.pubg.com/
PUBG_API_KEY=your_api_key_here

# 可选：多个 Key；与 PUBG_API_KEY 合并去重
# 写法 A 逗号分隔：PUBG_API_KEYS=key1,key2,key3
# 写法 B JSON 数组：PUBG_API_KEYS=["key1","key2","key3"]
# 请求按序轮询；遇官方 429 自动换下一个 Key，全部限流才抛错
# PUBG_API_KEYS=key1,key2,key3

# BFF 网关限流：每 IP 每分钟请求数（滑动窗口，默认 30）
RATE_LIMIT_RPM=30

# 写操作 / 强制刷新更严限流（telemetry/parse、report/rebuild、history/sync、refresh、
# 以及 query 含 force/refresh）。未设置时默认为 RATE_LIMIT_RPM 的 1/3
RATE_LIMIT_MUTATION_RPM=10

# 是否信任反向代理传入的 X-Forwarded-For / X-Real-IP（默认 false）
# 仅在 Nginx 等已覆盖这些头、且 Node 不直接对外时设为 true；否则限流键退化为 unknown
TRUST_PROXY=false

# Remote MCP（/mcp）：默认关闭；设为 true/1/on/yes 可开启
MCP_ENABLED=false
# 开启 MCP 后必填；客户端 Authorization: Bearer <MCP_TOKEN>
MCP_TOKEN=change-me-to-a-long-random-string
