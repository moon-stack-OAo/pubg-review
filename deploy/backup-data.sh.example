#!/usr/bin/env bash
# 用法示例（勿直接当生产脚本盲跑，先改路径再 chmod +x）：
#   cp deploy/backup-data.sh.example /opt/pubg-review/scripts/backup-data.sh
#   chmod +x /opt/pubg-review/scripts/backup-data.sh
#   # cron（每天 03:15）：
#   15 3 * * * /opt/pubg-review/scripts/backup-data.sh >> /var/log/pubg-data-backup.log 2>&1
#
# 恢复思路：
#   tar -C /opt/pubg-review -xzf /var/backups/pubg-review/pubg-data-YYYY-MM-DD.tgz
#   # 解压后应出现 /opt/pubg-review/.data/；再 pm2 reload pubg-review

set -euo pipefail

APP_DIR="${APP_DIR:-/opt/pubg-review}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/pubg-review}"
KEEP_DAYS="${KEEP_DAYS:-7}"
STAMP="$(date +%F)"
ARCHIVE="${BACKUP_DIR}/pubg-data-${STAMP}.tgz"

mkdir -p "${BACKUP_DIR}"

if [[ ! -d "${APP_DIR}/.data" ]]; then
  echo "skip: ${APP_DIR}/.data 不存在" >&2
  exit 0
fi

tar -C "${APP_DIR}" -czf "${ARCHIVE}" .data
echo "ok: ${ARCHIVE}"

# 删除超过 KEEP_DAYS 天的旧包
find "${BACKUP_DIR}" -maxdepth 1 -type f -name 'pubg-data-*.tgz' -mtime "+${KEEP_DAYS}" -print -delete
